+    @staticmethod
+    def _load_records_safely() -> tuple[list[dict], str | None]:
+        # A single malformed line (hand edit, interrupted write from an
+        # older version, disk/sync-tool corruption) must not make the
+        # whole application unlaunchable. Degrade to an empty in-memory
+        # list and surface a clear, actionable status-bar warning instead
+        # of letting the exception propagate out of __init__.
+        try:
+            return load_records(DATA_FILE_PATH), None
+        except jsonlines.InvalidLineError as exc:
+            return [], (
+                f"Could not read {DATA_FILE_PATH.name} ({exc}) — starting "
+                "with an empty list. Fix or back up the file, then restart."
+            )
+        except OSError as exc:
+            return [], (
+                f"Could not read {DATA_FILE_PATH.name} ({exc}) — starting "
+                "with an empty list."
